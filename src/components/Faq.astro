---
import { FAQS } from '../data/faq';
---

<div class="faq">
  {
    FAQS.map((f) => (
      <details class="faq__item">
        <summary>
          <span>{f.q}</span>
          <span class="faq__plus" aria-hidden="true">+</span>
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  /* <details> nativo: acordeón accesible y sin JavaScript. */
  .faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 44px;
  }
  .faq__item {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 19px 22px;
    cursor: pointer;
    font-size: 16.5px;
    font-weight: 800;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__plus {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: rgba(200, 245, 49, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lime);
    font-size: 17px;
    font-weight: 900;
    transition: transform 0.2s;
  }
  .faq__item[open] .faq__plus {
    transform: rotate(45deg);
  }
  .faq__item p {
    margin: 0;
    padding: 0 22px 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-muted);
    font-weight: 600;
  }
</style>
