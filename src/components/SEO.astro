---
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Excluir de buscadores (ej. páginas de gracias). */
  noindex?: boolean;
  /** JSON-LD extra a inyectar en esta página. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, schema } = Astro.props;

// Con build.format:'file' Astro sirve /index.html y /soporte.html, pero el
// canonical debe apuntar a la URL limpia (/ y /soporte) o Google indexa dos veces.
const cleanPath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
  .replace(/\/$/, '') || '/';

const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = new URL(SITE.ogImage, Astro.site).href;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — alarma de llegada por GPS`} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Iconos y color de barra -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content={SITE.themeColor} />

{
  schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))
}
