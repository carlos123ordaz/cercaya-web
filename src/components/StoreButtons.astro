---
import { APP_STORE_URL } from '../consts';

interface Props {
  align?: 'left' | 'center';
}
const { align = 'center' } = Astro.props;
---

<div class="stores" style={`justify-content:${align === 'center' ? 'center' : 'flex-start'}`}>
  {
    APP_STORE_URL ? (
      <a href={APP_STORE_URL} class="store" rel="noopener">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" style="fill:currentColor">
          <path d="M17.05 12.54c-.03-2.9 2.37-4.29 2.48-4.36-1.35-1.97-3.45-2.24-4.2-2.27-1.79-.18-3.49 1.05-4.4 1.05-.9 0-2.3-1.02-3.79-1-1.95.03-3.74 1.13-4.74 2.87-2.02 3.5-.52 8.69 1.45 11.53.96 1.39 2.11 2.95 3.62 2.9 1.45-.06 2-.94 3.75-.94s2.25.94 3.79.91c1.56-.03 2.55-1.42 3.51-2.82 1.1-1.62 1.56-3.18 1.58-3.26-.03-.02-3.03-1.17-3.05-4.61zM14.16 4.02c.8-.97 1.34-2.32 1.19-3.66-1.15.05-2.55.77-3.38 1.74-.74.86-1.39 2.23-1.22 3.55 1.29.1 2.6-.65 3.41-1.63z" />
        </svg>
        <span>
          <small>Descárgalo en el</small>
          <strong>App Store</strong>
        </span>
      </a>
    ) : (
      <span class="store store--soon" aria-disabled="true">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" style="fill:currentColor">
          <path d="M17.05 12.54c-.03-2.9 2.37-4.29 2.48-4.36-1.35-1.97-3.45-2.24-4.2-2.27-1.79-.18-3.49 1.05-4.4 1.05-.9 0-2.3-1.02-3.79-1-1.95.03-3.74 1.13-4.74 2.87-2.02 3.5-.52 8.69 1.45 11.53.96 1.39 2.11 2.95 3.62 2.9 1.45-.06 2-.94 3.75-.94s2.25.94 3.79.91c1.56-.03 2.55-1.42 3.51-2.82 1.1-1.62 1.56-3.18 1.58-3.26-.03-.02-3.03-1.17-3.05-4.61zM14.16 4.02c.8-.97 1.34-2.32 1.19-3.66-1.15.05-2.55.77-3.38 1.74-.74.86-1.39 2.23-1.22 3.55 1.29.1 2.6-.65 3.41-1.63z" />
        </svg>
        <span>
          <small>Muy pronto en el</small>
          <strong>App Store</strong>
        </span>
      </span>
    )
  }
</div>

<style>
  .stores {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .store {
    display: flex;
    align-items: center;
    gap: 11px;
    background: #f2f5ff;
    color: #0b1020;
    border-radius: 16px;
    padding: 13px 24px;
  }
  .store:hover {
    color: #0b1020;
    background: #fff;
  }
  .store--soon {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--ink);
    cursor: default;
  }
  .store small {
    display: block;
    font-size: 11px;
    font-weight: 700;
  }
  .store strong {
    display: block;
    font-size: 17px;
    font-weight: 900;
    line-height: 1.1;
  }
  .store span {
    text-align: left;
  }
</style>
